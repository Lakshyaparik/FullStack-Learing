<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cart-Page</title>
    <style>
      /* Page background */
body{
  background:#f4f6f9;
  font-family: Arial, Helvetica, sans-serif;
}

/* Cart container */
.cart-container{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:30px;
  padding:40px;
}

/* Product card */
.cart-item{
  width:240px;
  background:white;
  border-radius:12px;
  padding:15px;
  box-shadow:0 5px 20px rgba(0,0,0,0.1);
  transition:0.3s;
  text-align:center;
}

/* Hover effect */
.cart-item:hover{
  transform:translateY(-6px);
  box-shadow:0 10px 25px rgba(0,0,0,0.15);
}

/* Product image */
.cart-item img{
  width:100%;
  height:180px;
  object-fit:cover;
  border-radius:8px;
}

/* Product name */
.cart-item h3{
  font-size:18px;
  margin:10px 0;
  color:#333;
}

/* Price */
.cart-item p{
  font-size:16px;
  color:#27ae60;
  font-weight:bold;
  margin-bottom:10px;
}

/* Remove button */
.cart-item button{
  background:#ff4d4d;
  color:white;
  border:none;
  padding:8px 15px;
  border-radius:6px;
  cursor:pointer;
  font-size:14px;
  transition:0.3s;
}

/* Button hover */
.cart-item button:hover{
  background:#e60000;
}
    </style>
  </head>
  <body>
    <h1>Your Cart</h1>

<div class="cart-container">

<% cartProducts.forEach(function(product){ %>

<div class="cart-item">

    <img 
    src="data:<%= product.image.contentType %>;base64,<%= product.image.data.toString('base64') %>" 
    width="150">

    <h3><%= product.name %></h3>

    <p>Price: ₹<%= product.price %></p>

    <button>Remove</button>

</div>

<% }) %>

</div>
  </body>
</html>
