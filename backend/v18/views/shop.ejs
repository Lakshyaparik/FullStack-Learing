<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bags Store</title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, Helvetica, sans-serif;
      }

      body {
        background: #f4f4f4;
      }

      /* Layout */

      .container {
        display: flex;
        width: 100%;
        min-height: 100vh;
      }
      .nav{
        padding: 5px;
        position: absolute;
        right: 0;
        width: 400px;
        margin-right: 20px;
      }
      .nav-links{
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        list-style: none;
      }

      a{
        text-decoration: none;
        color: #fff;
        cursor: pointer;
        transition: 0.3s

      }

      .logout-anchor{
        color: red;
      }

      .nav-anchor:hover{
        color: skyblue;
      }

      /* Sidebar */

      .sidebar {
        width: 35%;
        background: #111;
        color: white;
        padding: 30px;
      }

      .sidebar h2 {
        margin-bottom: 20px;
      }

      .sidebar ul {
        list-style: none;
      }

      .sidebar li {
        padding: 12px;
        margin-bottom: 8px;
        cursor: pointer;
        border-radius: 6px;
        transition: 0.3s;
      }

      .sidebar li:hover {
        background: #333;
        transform: translateX(6px);
      }

      /* Products */

      .products {
        width: 60%;
        padding: 40px;
        display: flex;
        flex-wrap: wrap;
        gap: 25px;
      }

      /* Card */

      .card {
        width: 220px;
        height: 350px;
        border-radius: 12px;
        padding: 15px;
        text-align: center;
        background: white;
        overflow: hidden;
        cursor: pointer;

        transition:
          transform 0.4s,
          box-shadow 0.4s;
      }

      /* Hover effect */

      .card:hover {
        transform: translateY(-10px) scale(1.05);
        box-shadow: 0 15px 35px skyblue
      }

      /* Image zoom animation */

      .card img {
        width: 100%;
        height: 200px;
        object-fit: contain;
        border-radius: 8px;
        transition: transform 0.5s;
      }

      .card:hover img {
        transform: scale(1.1);
      }

      /* Text */

      .card h3 {
        margin-top: 12px;
      }

      .card p {
        margin-top: 6px;
        font-weight: bold;
        color: #444;
      }

      /* Button */

      .card button {
        margin-top: 12px;
        padding: 8px 18px;
        border: none;
        background: black;
        color: white;
        border-radius: 6px;
        cursor: pointer;

        transition:
          transform 0.3s,
          box-shadow 0.3s,
          background 0.3s;
      }

      .card button:hover {
        background: #ff4d4d;
        transform: scale(1.1);
        box-shadow: 0 5px 15px rgba(255, 77, 77, 0.6);
      }
    </style>
  </head>

  <body>
    <div class="container">
      <nav class="nav">
        <ul class="nav-links">
          <li><a class="nav-anchor" href="">Home</a></li>
          <li><a class="nav-anchor" href="/users/cart">Cart</a></li>
          <li><a class="nav-anchor" href="">Profile</a></li>
          <li><a class="nav-anchor logout-anchor" href="">Logout</a></li>
        </ul>
      </nav>
      <div class="sidebar">
        <h2>Categories</h2>

        <ul>
          <li>School Bags</li>
          <li>Laptop Bags</li>
          <li>Travel Bags</li>
          <li>Office Bags</li>
          <li>Hand Bags</li>
        </ul>
      </div>
      <div class="products">
        <% products.forEach(function(product){ %>

<div class="card">
  <!-- to convert buffer into image we have to convert into base64 encoding
  also the html img tag should be holding   data : [file-type],base64,data(buffer) in base64 -->
  <img src="data:<%= product.image.contentType%>;base64,<%= product.image.data.toString('base64') %>" />
  <h3><%= product.name %></h3>
  <h4>₹<%= product.price %></h4>
  <p><%= product.description %></p>
  <a href="/users/addToCart/<%= product._id %>"><button>Add to Cart</button></a>
</div>

<% }) %>
      </div>
    </div>
  </body>
</html>
