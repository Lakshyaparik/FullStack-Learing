<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
    <link rel="stylesheet" href="/stylesheets/profile.css" />
    <script src="https://kit.fontawesome.com/2bfdf0f8e6.js" crossorigin="anonymous"></script>
  </head>
  <body>
    <h1>Your posts</h1>
    <div class="container" style="flex-direction: row;">
      <% user.posts.reverse().forEach(function(post) { %>
      <div class="post">
         <h1><%= post.title %></h1>
    <p><%= post.description %></p>

    
    <div class="change-btn">
      <a href="/edit-post/<%= post._id %>">edit</a>
      <a href="/delete-post/<%= post._id %>" >delete</a >
      <a href="/like-post/<%= post._id %>"><i class="fa-solid fa-thumbs-up"></i>&nbsp;
        <%= post.like.length %>&nbsp;
        <%= post.like.includes(user._id) ? 'Unlike' : 'Like' %>
      </a >
    </div>
      </div>
<% }) %>
<a href="/profile" style="position: absolute; right: 20px; bottom: 10%;">Go to profile</a>
    </div>
  </body>
</html>
