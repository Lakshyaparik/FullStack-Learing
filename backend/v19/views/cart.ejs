<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shop Page</title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, Helvetica, sans-serif;
      }

      body {
        background-color: #f5f5f5;
      }
      a:hover{
        color: red !important;
      }
      .main {
        width: 100%;
        min-height: 100vh;
        display: flex;
      }
      .category {
        display: flex;
        flex-direction: column;
        gap: 15px;
      }

      .category button {
        padding: 14px;
        border: none;
        background-color: #f1f1f1;
        cursor: pointer;
        border-radius: 10px;
        text-align: left;
        font-size: 16px;
        transition: 0.3s;
      }

      .category button:hover {
        background-color: black;
        color: white;
      }

      /* RIGHT PRODUCTS */

      .products {
        margin-top: 70px;
        width: 100%;
        padding: 30px;
        display: flex;
        flex-flow: row wrap;
        gap: 30px;
      }
      .navbar{
            background: black;
        display: flex;
        list-style: none;
        justify-content: flex-end;
        gap: 20px;
        position: absolute;
        top: 0;
        right: 10px;
        width: 30%;
        display: flex;
        gap: 50px;
        padding: 15px 0;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        padding-right: 30px;
      }
      .navbar a {
        text-decoration: none;
        color: #fff;
        font-weight: bold;
        transition: 0.3s;
      }
      .card {
        width: 300px;
        height: 350px;
        background-color: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        transition: 0.3s;
        padding: 5px;
      }

      .card:hover {
        transform: translateY(-5px);
      }

      .card img {
        width: 100%;
        height: 220px;
        object-fit: cover;
      }

      .card-content {
        padding: 15px;
      }

      .card-content h3 {
        margin-bottom: 10px;
      }

      .price {
        color: green;
        font-weight: bold;
        margin-bottom: 12px;
      }

      .card-content button {
        width: 100%;
        padding: 10px;
        border: none;
        background-color: black;
        color: white;
        border-radius: 8px;
        cursor: pointer;
      }

      .card-content button:hover {
        background-color: #333;
      }

      /* RESPONSIVE */

      @media (max-width: 900px) {
        .main {
          flex-direction: column;
        }

        .sidebar {
          width: 100%;
        }

        .products {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <div class="main">
      <h1 style="position:absolute;top:10px;left:30px;"
      >Cart Page</h1>
     <nav class="navbar">
      <a href="/user/home"><li >Home</li></a>
      <% if(user.role === 'owner') { %>
        <a href="/user/createProduct"><li >Add Product</li></a>
      <% } %>
      <a href="/user/cart"><li >Cart</li></a>
      <a href="/user/profile"><li >Profile</li></a>
      <a href="/user/logout"><li >Logout</li></a>
      </nav>
      <!-- RIGHT PRODUCTS -->
    <div class="products" id="products">

  <% products.forEach(product=>{ %>

    <div class="card">

      <img 
src="data:<%= product.image.contentType %>;base64,<%= product.image.data.toString('base64') %>"
>

      <div class="card-content">

        <h3><%= product.title %></h3>

        <p class="price">₹<%= product.price %></p>

        <form action="/user/cart/delete/<%= product._id %>" method="post">
          <button>Delete From Cart</button>
        </form>

      </div>

    </div>

  <% }) %>

</div>
    </div>

    <script>
      function filterProducts(category) {
        let cards = document.querySelectorAll(".card");

        cards.forEach(function (card) {
          if (category === "all") {
            card.style.display = "block";
          } else if (card.dataset.category === category) {
            card.style.display = "block";
          } else {
            card.style.display = "none";
          }
        });
      }
    </script>
  </body>
</html>
