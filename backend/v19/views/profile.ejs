<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      background-color: #f5f5f5;
    }
    a:hover {
      color: red !important;
    }
    .container {
      width: 100vw;
      height: 100vh;
    }
    .profileCard {
      width: 400px;
      height: 500px;
      border: 2px solid;
      transform: translateX(600px);
    }
    .navbar {
          background: black;
      display: flex;
      list-style: none;
      justify-content: flex-end;
      gap: 20px;
      position: absolute;
      top: 0;
      right: 10px;
      width: 30%;
      display: flex;
      gap: 50px;
      padding: 15px 0;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      padding-right: 30px;
    }
    .navbar a {
      text-decoration: none;
      color: #fff;
      font-weight: bold;
      transition: 0.3s;
    }
    .profileCard {
      display: flex;
      flex-flow: row wrap;
      justify-content: center;
      align-items: center;
    }
    .profileCard img {
      border-radius: 50%;
    }
    .profiletxt {
      display: flex;
      flex-direction: column;
      gap: 20px;
      margin-left: 20px;
    }
  </style>
  <body>
    <div class="container">
      <h1 style="position: absolute; top: 10px; left: 30px">Cart Page</h1>
      <nav class="navbar">
        <a href="/user/home"><li>Home</li></a>
         <% if(user.role === 'owner') { %>
        <a href="/user/createProduct"><li >Add Product</li></a>
      <% } %>
        <a href="/user/cart"><li>Cart</li></a>
        <a href="/user/profile"><li>Profile</li></a>
        <a href="/user/logout"><li>Logout</li></a>
      </nav>
      <div class="profileCard">
        <img src="<%= user.profilePic %>" alt="" width="200px" />

        <div class="profiletxt">
          <h3>Name : <%= user.fullname %></h3>
          <h3>Email : <%= user.email %></h3>
          <h4>Role : <%= user.role %></h4>
          <p>
            Lorem ipsum, dolor sit amet consectetur adipisicing elit. Inventore
            ab debitis accusamus ipsam, itaque similique placeat neque quae
            nihil atque.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
